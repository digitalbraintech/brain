{
  "mcpServers": {
    "aspire": {
      "command": "aspire",
      "args": ["agent", "mcp"]
    },
    "dart": {
      "command": "dart",
      "args": ["mcp-server"]
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp@latest"]
    },
    "codegraph": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@colbymchenry/codegraph@latest",
        "serve",
        "--mcp"
      ]
    },
    "brain": {
      "type": "http",
      "url": "http://localhost:5080/mcp"
    }
  }
}
