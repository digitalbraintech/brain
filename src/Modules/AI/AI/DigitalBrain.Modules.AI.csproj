<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>AI module: multi-provider LLM and embedding clients, agents, and voice transcription.</Description>
    <RootNamespace>DigitalBrain.AI</RootNamespace>
    <NoWarn>$(NoWarn);ORLEANSEXP005;CA1812</NoWarn>
    <!-- Foundry natives are Windows-only; CI clears RuntimeIdentifier via Directory.Build.props. -->
    <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- AIClients binds configuration values (GetValue) — declare Binder explicitly so
         consumers resolve the version this assembly compiles against on every OS, instead
         of inheriting it from the Windows-only Foundry Local graph. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" />
    <PackageReference Include="OllamaSharp" />
    <!-- Private so Foundry native RID does not force AppHost/Aspire.Hosting to win-x64. -->
    <PackageReference Include="Microsoft.AI.Foundry.Local" PrivateAssets="all" />
    <PackageReference Include="Concentus" />
    <PackageReference Include="Concentus.Oggfile" />
    <PackageReference Include="NAudio" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../../../docs/examples/github-pr-review.csx" LogicalName="DigitalBrain.Examples.github-pr-review.csx" />
    <EmbeddedResource Include="../../../../docs/examples/personal-code-review.csx" LogicalName="DigitalBrain.Examples.personal-code-review.csx" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Product/DigitalBrain.Product.Contracts/DigitalBrain.Product.Contracts.csproj" />
    <ProjectReference Include="../Contracts/DigitalBrain.Modules.AI.Contracts.csproj" />
    <ProjectReference Include="../../../Kernel/DigitalBrain/DigitalBrain.csproj" />
    <ProjectReference Include="../../../Kernel/DigitalBrain.Sdk/DigitalBrain.Sdk.csproj" />
    <ProjectReference Include="../../Memory/Contracts/DigitalBrain.Modules.Memory.Contracts.csproj" />
  </ItemGroup>
</Project>
