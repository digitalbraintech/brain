<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DigitalBrain.Scripting</RootNamespace>
    <Description>Immutable file application compilation and authoring for DigitalBrain.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DigitalBrain.Contracts/DigitalBrain.Contracts.csproj" />
    <ProjectReference Include="../DigitalBrain.Sdk/DigitalBrain.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DigitalBrain.Simulation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="scripts/**/*.cs" />
    <Content Include="scripts/**/*.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
