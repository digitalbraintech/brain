<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Saved programs are runtime data, compiled separately by the application host. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);applications/**;.digitalbrain/**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);CA2007;CA1812</NoWarn>
    <!-- Host pin for Foundry Local native assets on Windows desktop runs only. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(CI)' != 'true' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DigitalBrain.Authoring.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Content Include="../DigitalBrain.Scripting/scripts/**/*.cs"
             Link="scripts/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!-- Foundry Local is Windows-native; including it in linux containers SIGSEGVs at startup (exit 139). -->
    <PackageReference Include="Microsoft.AI.Foundry.Local"
                      Condition="'$(RuntimeIdentifier)' != 'linux-x64' and '$(ContainerRuntimeIdentifier)' != 'linux-x64'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Product/DigitalBrain.Product.Contracts/DigitalBrain.Product.Contracts.csproj" />
    <ProjectReference Include="../../Modules/AI/AI/DigitalBrain.Modules.AI.csproj" />
    <ProjectReference Include="../../Modules/UI/DigitalBrain.Modules.UI/DigitalBrain.Modules.UI.csproj" />
    <ProjectReference Include="../../Modules/Time/Time/DigitalBrain.Modules.Time.csproj" />
    <ProjectReference Include="../../Modules/Excel/Excel/DigitalBrain.Modules.Excel.csproj" />
    <ProjectReference Include="../../Modules/Memory/Memory/DigitalBrain.Modules.Memory.csproj" />
    <ProjectReference Include="../../Modules/Execution/Execution/DigitalBrain.Modules.Execution.csproj" />
    <ProjectReference Include="../../Modules/Google/Google/DigitalBrain.Modules.Google.csproj" />
    <ProjectReference Include="../../Modules/Salesforce/Salesforce/DigitalBrain.Modules.Salesforce.csproj" />
    <ProjectReference Include="../../Modules/Microsoft/Microsoft/DigitalBrain.Modules.Microsoft.csproj" />
    <ProjectReference Include="../../Aspire/DigitalBrain.Aspire/DigitalBrain.Aspire.csproj" />
    <ProjectReference Include="../DigitalBrain/DigitalBrain.csproj" />
    <ProjectReference Include="../DigitalBrain.Sdk/DigitalBrain.Sdk.csproj" />
    <ProjectReference Include="../DigitalBrain.Scripting/DigitalBrain.Scripting.csproj" />
  </ItemGroup>
</Project>
